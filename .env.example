# Local development. Copy to .env and adjust.
# .env is gitignored — never commit real secrets.

# --- Database -----------------------------------------------------------------
DB_NAME=webapp_base
DB_ROOT_PASSWORD=rootpassword

# --- Configuration source -----------------------------------------------------
# Local development reads configuration from this file. Deployed environments set
# this to true and read from AWS SSM Parameter Store instead.
USE_PARAMETER_STORE=false
ASPNETCORE_ENVIRONMENT=Development

# --- SkaapHond (authentication) -----------------------------------------------
SKAAPHOND_API_URL=https://skaaphond.konnek360.co.za
# Must match the key SkaapHond signs with, and be at least 32 bytes.
SKAAPHOND_SIGNING_KEY=local-development-signing-key-replace-me-32b
# Skips issuer/audience checks. Local development only — never true in production.
SKAAPHOND_ALLOW_UNVERIFIED=true
# Key used when creating accounts. Empty locally; from Parameter Store when deployed.
SKAAPHOND_API_KEY=
# Numeric id of the Client role in SkaapHond. Roles are assigned by id, not name, and
# the id differs per environment. Zero disables self-registration.
SKAAPHOND_CLIENT_ROLE_ID=0
# Tenant dimensions stamped on self-registered accounts. Both are required by SkaapHond.
SKAAPHOND_DATA_HOLDER_ID=1
SKAAPHOND_ENTITY_ID=1

# --- WolkPoort (other GroeiSentrum services) ----------------------------------
# Only needed once a deployment calls a downstream service such as Spilpunt.
WOLKPOORT_API_URL=https://wolkpoort.konnek360.co.za

# --- Posduif (notifications) --------------------------------------------------
POSDUIF_URL=https://posduif.konnek360.co.za
POSDUIF_API_KEY=
# Off locally: queued notifications are recorded but not sent.
POSDUIF_ENABLED=false
