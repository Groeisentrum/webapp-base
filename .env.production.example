# Production reference for a client deployment.
#
# Only non-secret values belong here. Secrets — the database password, the SkaapHond
# signing key, the Posduif API key — come from AWS SSM Parameter Store under
# /GroeiSentrum/WebappBase/, which the API reads at startup when
# USE_PARAMETER_STORE is true. Do not paste secret values into this file or .env
# on the instance.

# --- Database -----------------------------------------------------------------
DB_NAME=webapp_base

# --- Configuration source -----------------------------------------------------
# True in production: the API loads configuration and secrets from Parameter Store.
USE_PARAMETER_STORE=true
ASPNETCORE_ENVIRONMENT=Production

# --- SkaapHond (authentication) -----------------------------------------------
SKAAPHOND_API_URL=https://skaaphond.konnek360.co.za
# Must be false in production — leaving it true weakens token validation.
SKAAPHOND_ALLOW_UNVERIFIED=false

# --- WolkPoort ----------------------------------------------------------------
WOLKPOORT_API_URL=https://wolkpoort.konnek360.co.za

# --- Posduif (notifications) --------------------------------------------------
POSDUIF_URL=https://posduif.konnek360.co.za
POSDUIF_ENABLED=true
